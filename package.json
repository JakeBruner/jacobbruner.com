{
  "private": true,
  "name": "jacobbruner.com",
  "version": "0.0.1",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm build:wasm",
    "build:wasm": "wasm-pack build game-of-life --target web --release --no-gitignore -- --locked && python3 scripts/fixwasm.py",
    "build:wasm3": "pnpm build:wasm",
    "watch:wasm": "cd game-of-life && cargo watch -i \"pkg/*\" -i \"target/*\" -s \"wasm-pack build --target web --dev --locked\"",
    "test:wasm": "cargo test --manifest-path game-of-life/Cargo.toml --locked && wasm-pack test --node game-of-life --locked && node --test game-of-life/tests/pkg.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "node --test tests/unit/*.test.mjs tests/unit/*.test.ts",
    "test:posts": "node scripts/check-posts.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JakeBruner/jacobbruner.com"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "mdsvex": "0.12.8",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-wasm": "3.6.0"
  },
  "type": "module",
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "game-of-life": "file:game-of-life/pkg",
    "gpu-io": "0.2.7",
    "svelte-heros-v2": "3.0.1",
    "svelte-inview": "4.0.5",
    "svelte-portal": "2.2.1",
    "web-vitals": "6.2.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.18.0",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/components/*"
  }
}
